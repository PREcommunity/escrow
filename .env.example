BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org
ETHERSCAN_API_KEY=
PRE_ADDRESS=
USDC_ADDRESS=
PRE_ADDRESS_TESTNET=
USDC_ADDRESS_TESTNET=
OWNER_ADDRESS=
OWNER_ADDRESS_TESTNET=
SAFE_ADDRESS=
SAFE_ADDRESS_TESTNET=
TREASURY_ADDRESS=
TREASURY_ADDRESS_TESTNET=
TREASURY_PAYOUT_ADDRESS=
TREASURY_PAYOUT_ADDRESS_TESTNET=
ESCROW_ADDRESS=
ESCROW_ADDRESS_TESTNET=
DEPLOYMENT_BLOCK=
DEPLOYMENT_BLOCK_TESTNET=
DEPLOYMENT_CHECK_STAGE=final
ADS_CONTRACT_ADDRESS=
ADS_CONTRACT_ADDRESS_TESTNET=
ADS_CONTRACT_DEPLOYMENT_BLOCK=
ADS_CONTRACT_DEPLOYMENT_BLOCK_TESTNET=
# Optional. Empty expects the billing operator to remain zero.
ADS_OPERATOR_ADDRESS=
ADS_OPERATOR_ADDRESS_TESTNET=
# Set to 1 only for a reviewed Base mainnet Keyword Market deployment.
KEYWORD_MARKET_ALLOW_MAINNET=0
# Defaults to the confirmed manifest initial state; explicit rollout/active override.
KEYWORD_MARKET_CHECK_STAGE=
# Active at deployment by default; set 1 to require Safe unpause later.
KEYWORD_MARKET_START_PAUSED=0
KEYWORD_MARKET_START_PAUSED_TESTNET=0
# Optional named deployment preserves earlier manifests and locks.
KEYWORD_MARKET_DEPLOYMENT_NAME=
KEYWORD_MARKET_DEPLOYMENT_NAME_TESTNET=
KEYWORD_MARKET_MINIMUM_PRE=
KEYWORD_MARKET_MINIMUM_PRE_TESTNET=1
GOAL_MANAGER_ADDRESS=
GOAL_MANAGER_ADDRESS_TESTNET=
GOAL_MANAGER_ENABLED=
