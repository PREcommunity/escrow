{
  "name": "@precommunity/escrow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "PREcommunityEscrowV1 smart contract for the independent precommunity ledger",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "hardhat compile",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage && node scripts/check-coverage.mjs",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "lint:sol:fix": "solhint --fix \"contracts/**/*.sol\"",
    "keystore:create": "hardhat run scripts/create-keystore.ts",
    "deploy:test-tokens": "hardhat run scripts/deploy-test-tokens.ts",
    "preflight:escrow": "hardhat run scripts/preflight.ts",
    "deploy:escrow": "hardhat run scripts/deploy.ts",
    "ownership:handoff": "hardhat run scripts/handoff-ownership.ts",
    "check:escrow": "hardhat run scripts/check-deployment.ts",
    "verify:escrow": "hardhat run scripts/verify.ts",
    "verify:sourcify": "hardhat run scripts/verify-sourcify.ts",
    "goal-manager:set": "hardhat run scripts/set-goal-manager.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^3.0.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-keystore": "3.0.12",
    "@nomicfoundation/hardhat-mocha": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "@nomicfoundation/hardhat-typechain": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^3.0.0",
    "@nomicfoundation/ignition-core": "^3.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "chai": "6.2.2",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "fast-check": "^4.9.0",
    "hardhat": "3.12.0",
    "mocha": "^11.8.0",
    "solhint": "6.2.4",
    "typescript": "^7.0.2"
  }
}
